# Raw datasets: ~10 GB, downloaded rather than tracked. See docs/REPRODUCING.md.
# Anchored with a leading slash: an unanchored rule would also match the
# package's own gcrl/data/ module.
/data/
/code/data/

# Trained encoders and policies: regenerable from the configs, hundreds of MB.
/artifacts/
/code/artifacts/

# Run logs. The result files they produced are committed; the logs are not.
/logs/
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Build outputs regenerated by scripts/generate_paper_tables.py
results/paper/*.tex

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Working files that are not part of the record
*.bak
*.bak2
*.tgz
*.tmp
